# API keys for cloud/remote model providers
# TODO: Move provider configuration to the config panel
OPENAI_API_KEY=
OLLAMA_API_KEY=

# Required for web search
# TODO: Move web search configuration to the config panel
TAVILY_API_KEY=

# Server port (default: 3000)
# Set to 0 (or leave empty) to use an automatically assigned available port (not recommended)
PORT=

# Address to listen on (default: 0.0.0.0)
HOSTNAME=

# Enable production mode
# Set to "1" or "true" to enable; any other value or an empty value disables it
PRODUCTION=
